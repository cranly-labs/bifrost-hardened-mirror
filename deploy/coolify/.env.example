# Coolify environment for the production Compose service.
# Copy the values into Coolify; do not commit a populated .env file.

# Generate with: openssl rand -hex 32
BIFROST_SETUP_TOKEN=

# Generate once with: openssl rand -hex 32
# Keep this value stable across restarts, upgrades, backups, and restores.
BIFROST_ENCRYPTION_KEY=

LOG_LEVEL=info
LOG_STYLE=json
GOGC=200
GOMEMLIMIT=1800MiB
TZ=UTC

# Compose resource limits. Match GOMEMLIMIT to ~90% of BIFROST_MEMORY_LIMIT.
BIFROST_CPU_LIMIT=2
BIFROST_MEMORY_LIMIT=2G

# Stable volume name. Change only with a planned data migration.
BIFROST_VOLUME_NAME=bifrost-data

# Used only when deploying deploy/coolify/compose.yaml from the main branch.
# The generated production branch pins a digest instead.
BIFROST_IMAGE=ghcr.io/cranly-labs/bifrost-hardened-mirror:v2.4.0
