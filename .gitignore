# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# Local runtime state
/data/
/.tmp/
/dist/
/sbom/
*.db
*.db-shm
*.db-wal
*.log

# Tooling
node_modules/
coverage/
.idea/
.vscode/
.DS_Store

# macOS
.AppleDouble
.LSOverride

# Python tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# The vendored snapshot must be complete. Upstream .gitignore files are removed
# by the sync script so these negations cover the entire mirror.
!upstream/**
upstream/**/node_modules/
